<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Roihan Syafiq A.A — Portfolio</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

/* =========================================================
   ROOT
========================================================= */

:root {
    --bg: #08090b;
    --bg-soft: #0d0f12;
    --card: rgba(255,255,255,.045);

    --white: #f5f5f3;
    --text: #d8d8d8;
    --muted: #85888d;

    --line: rgba(255,255,255,.09);

    --accent: #c9ff62;
    --accent-soft: rgba(201,255,98,.12);

    --purple: #9d7cff;
    --blue: #66d9ff;

    --radius: 24px;
}


/* =========================================================
   RESET
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Manrope", sans-serif;

    background:
        radial-gradient(
            circle at 15% 10%,
            rgba(157,124,255,.12),
            transparent 28%
        ),
        radial-gradient(
            circle at 85% 20%,
            rgba(102,217,255,.08),
            transparent 25%
        ),
        var(--bg);

    color: var(--text);

    line-height: 1.8;

    overflow-x: hidden;
}


/* =========================================================
   GLOBAL
========================================================= */

::selection {
    background: var(--accent);
    color: #000;
}

a {
    color: inherit;
}

.container {
    width: min(1180px, calc(100% - 48px));

    margin: auto;
}

section {
    scroll-margin-top: 100px;
}


/* =========================================================
   NOISE EFFECT
========================================================= */

body::before {
    content: "";

    position: fixed;

    inset: 0;

    pointer-events: none;

    opacity: .035;

    z-index: 999;

    background-image:
        url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
}


/* =========================================================
   NAVBAR
========================================================= */

.navbar {
    position: fixed;

    top: 20px;
    left: 50%;

    transform: translateX(-50%);

    width: min(1120px, calc(100% - 32px));

    z-index: 100;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 12px 14px 12px 20px;

    background: rgba(10,11,13,.72);

    border: 1px solid var(--line);

    backdrop-filter: blur(22px);

    border-radius: 100px;

    box-shadow:
        0 20px 50px rgba(0,0,0,.3);
}

.logo {
    display: flex;

    align-items: center;

    gap: 10px;

    text-decoration: none;

    font-weight: 800;

    letter-spacing: -.5px;

    color: var(--white);
}

.logo-mark {
    width: 32px;
    height: 32px;

    display: grid;

    place-items: center;

    border-radius: 50%;

    background: var(--accent);

    color: #050505;

    font-size: .72rem;

    font-weight: 800;
}

.nav-links {
    display: flex;

    align-items: center;

    gap: 5px;

    list-style: none;
}

.nav-links a {
    display: block;

    padding: 9px 15px;

    color: var(--muted);

    text-decoration: none;

    font-size: .72rem;

    font-weight: 600;

    transition: .25s ease;

    border-radius: 100px;
}

.nav-links a:hover {
    color: var(--white);

    background: rgba(255,255,255,.07);
}

.nav-contact {
    padding: 10px 17px;

    background: var(--white);

    color: #080808;

    border-radius: 100px;

    text-decoration: none;

    font-size: .72rem;

    font-weight: 800;

    transition: .25s ease;
}

.nav-contact:hover {
    background: var(--accent);

    transform: translateY(-2px);
}


/* =========================================================
   HERO
========================================================= */

.hero {
    min-height: 100vh;

    display: flex;

    align-items: center;

    padding: 150px 0 100px;

    position: relative;
}

.hero-grid {
    display: grid;

    grid-template-columns: 1.15fr .85fr;

    gap: 80px;

    align-items: center;
}


/* LEFT */

.hero-label {
    display: inline-flex;

    align-items: center;

    gap: 9px;

    padding: 7px 12px;

    border: 1px solid var(--line);

    border-radius: 100px;

    color: var(--muted);

    font-size: .68rem;

    font-weight: 600;

    letter-spacing: 1px;

    text-transform: uppercase;

    margin-bottom: 28px;
}

.status-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--accent);

    box-shadow:
        0 0 15px var(--accent);
}

.hero h1 {
    font-family: "DM Sans", sans-serif;

    font-size: clamp(4rem, 8vw, 7.5rem);

    line-height: .9;

    letter-spacing: -6px;

    color: var(--white);

    font-weight: 700;

    margin-bottom: 32px;
}

.hero h1 span {
    color: transparent;

    -webkit-text-stroke: 1px rgba(255,255,255,.55);
}

.hero-description {
    max-width: 590px;

    color: var(--muted);

    font-size: 1rem;

    line-height: 1.9;

    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;

    gap: 12px;

    flex-wrap: wrap;
}

.btn {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 10px;

    padding: 14px 21px;

    border-radius: 100px;

    text-decoration: none;

    font-size: .75rem;

    font-weight: 800;

    transition: .3s ease;
}

.btn-primary {
    background: var(--accent);

    color: #080808;
}

.btn-primary:hover {
    transform: translateY(-3px);

    box-shadow:
        0 12px 35px rgba(201,255,98,.18);
}

.btn-secondary {
    border: 1px solid var(--line);

    color: var(--white);
}

.btn-secondary:hover {
    background: rgba(255,255,255,.07);

    transform: translateY(-3px);
}


/* =========================================================
   HERO VISUAL
========================================================= */

.hero-visual {
    position: relative;

    display: flex;

    justify-content: center;
}

.profile-card {
    width: min(390px, 100%);

    aspect-ratio: .82;

    position: relative;

    overflow: hidden;

    border-radius: 35px;

    border: 1px solid var(--line);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.1),
            rgba(255,255,255,.025)
        );

    box-shadow:
        0 40px 100px rgba(0,0,0,.4);
}

.profile-card::before {
    content: "";

    position: absolute;

    width: 250px;
    height: 250px;

    background: var(--purple);

    filter: blur(100px);

    opacity: .35;

    top: -100px;
    right: -80px;
}

.profile-card img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    filter: grayscale(100%);

    transition: .7s ease;
}

.profile-card:hover img {
    filter: grayscale(0%);

    transform: scale(1.04);
}

.profile-overlay {
    position: absolute;

    left: 22px;
    right: 22px;
    bottom: 22px;

    padding: 17px 18px;

    background: rgba(10,10,11,.65);

    backdrop-filter: blur(18px);

    border: 1px solid rgba(255,255,255,.1);

    border-radius: 18px;
}

.profile-overlay small {
    color: var(--accent);

    font-size: .62rem;

    text-transform: uppercase;

    letter-spacing: 1.5px;
}

.profile-overlay strong {
    display: block;

    color: white;

    font-size: 1rem;

    margin-top: 2px;
}


/* FLOATING ELEMENT */

.float-card {
    position: absolute;

    padding: 13px 16px;

    background: rgba(15,16,18,.8);

    backdrop-filter: blur(18px);

    border: 1px solid var(--line);

    border-radius: 15px;

    font-size: .7rem;

    color: var(--muted);

    box-shadow:
        0 15px 35px rgba(0,0,0,.3);
}

.float-card strong {
    display: block;

    color: var(--white);

    font-size: .85rem;
}

.float-one {
    left: -45px;
    top: 20%;
}

.float-two {
    right: -35px;
    bottom: 18%;
}


/* =========================================================
   MARQUEE
========================================================= */

.marquee {
    overflow: hidden;

    border-top: 1px solid var(--line);

    border-bottom: 1px solid var(--line);

    padding: 18px 0;

    color: #4f5257;

    font-size: .68rem;

    font-weight: 700;

    letter-spacing: 2px;

    text-transform: uppercase;

    white-space: nowrap;
}

.marquee-track {
    display: inline-block;

    animation: marquee 25s linear infinite;
}

.marquee span {
    margin: 0 30px;
}

.marquee b {
    color: var(--accent);
}

@keyframes marquee {
    from {
        transform: translateX(0);
    }

    to {
        transform: translateX(-50%);
    }
}


/* =========================================================
   SECTION HEADER
========================================================= */

.section {
    padding: 130px 0;
}

.section-header {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 30px;

    margin-bottom: 55px;
}

.eyebrow {
    color: var(--accent);

    font-size: .68rem;

    font-weight: 800;

    letter-spacing: 2px;

    text-transform: uppercase;

    margin-bottom: 12px;
}

.section-title {
    font-family: "DM Sans", sans-serif;

    color: var(--white);

    font-size: clamp(2.2rem, 5vw, 4rem);

    line-height: 1;

    letter-spacing: -2.5px;
}

.section-description {
    max-width: 400px;

    color: var(--muted);

    font-size: .85rem;
}


/* =========================================================
   ABOUT
========================================================= */

.about-grid {
    display: grid;

    grid-template-columns: .75fr 1.25fr;

    gap: 80px;

    align-items: start;
}

.about-number {
    font-size: 8rem;

    line-height: .8;

    font-weight: 800;

    color: transparent;

    -webkit-text-stroke: 1px rgba(255,255,255,.15);

    letter-spacing: -8px;
}

.about-content p {
    color: #a7a9ad;

    font-size: .96rem;

    line-height: 2;

    margin-bottom: 20px;
}

.about-content p:first-child {
    color: var(--white);

    font-size: 1.15rem;

    line-height: 1.8;
}

.highlight {
    color: var(--accent);
}


/* =========================================================
   STATS
========================================================= */

.stats {
    display: grid;

    grid-template-columns: repeat(3,1fr);

    margin-top: 50px;

    border-top: 1px solid var(--line);

    border-bottom: 1px solid var(--line);
}

.stat {
    padding: 25px 15px;

    border-right: 1px solid var(--line);
}

.stat:last-child {
    border-right: none;
}

.stat strong {
    display: block;

    color: var(--white);

    font-size: 1.8rem;

    letter-spacing: -1px;
}

.stat span {
    color: var(--muted);

    font-size: .7rem;
}


/* =========================================================
   EDUCATION TIMELINE
========================================================= */

.timeline {
    position: relative;

    margin-left: 15px;

    border-left: 1px solid var(--line);
}

.timeline-item {
    position: relative;

    padding: 0 0 55px 45px;
}

.timeline-item:last-child {
    padding-bottom: 0;
}

.timeline-dot {
    position: absolute;

    left: -5px;
    top: 5px;

    width: 9px;
    height: 9px;

    border-radius: 50%;

    background: var(--accent);

    box-shadow:
        0 0 20px rgba(201,255,98,.4);
}

.timeline-year {
    color: var(--accent);

    font-size: .7rem;

    font-weight: 800;

    letter-spacing: 1px;
}

.timeline h3 {
    font-size: 1.4rem;

    color: var(--white);

    margin: 7px 0 5px;
}

.timeline p {
    color: var(--muted);

    font-size: .82rem;
}


/* =========================================================
   SKILLS
========================================================= */

.skills-grid {
    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 15px;
}

.skill {
    position: relative;

    min-height: 180px;

    padding: 25px;

    background: var(--card);

    border: 1px solid var(--line);

    border-radius: 22px;

    overflow: hidden;

    transition: .35s ease;
}

.skill::after {
    content: "";

    position: absolute;

    width: 100px;
    height: 100px;

    border-radius: 50%;

    background: var(--accent);

    filter: blur(70px);

    opacity: 0;

    right: -50px;
    bottom: -50px;

    transition: .4s;
}

.skill:hover {
    transform: translateY(-7px);

    border-color: rgba(201,255,98,.3);
}

.skill:hover::after {
    opacity: .15;
}

.skill-number {
    color: #55585d;

    font-size: .7rem;

    font-weight: 800;
}

.skill h3 {
    color: var(--white);

    font-family: "Manrope", sans-serif;

    font-size: 1rem;

    margin: 35px 0 8px;
}

.skill p {
    color: var(--muted);

    font-size: .72rem;

    line-height: 1.7;
}


/* =========================================================
   HOBBY
========================================================= */

.hobby-grid {
    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 15px;
}

.hobby {
    padding: 30px;

    border: 1px solid var(--line);

    border-radius: 20px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.055),
            rgba(255,255,255,.015)
        );

    transition: .3s;
}

.hobby:hover {
    transform: translateY(-5px);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.08),
            rgba(255,255,255,.02)
        );
}

.hobby-icon {
    font-size: 1.5rem;

    margin-bottom: 30px;
}

.hobby h3 {
    font-family: "Manrope", sans-serif;

    font-size: .95rem;

    color: var(--white);

    margin-bottom: 5px;
}

.hobby p {
    color: var(--muted);

    font-size: .72rem;
}


/* =========================================================
   PROJECT
========================================================= */

.project-card {
    position: relative;

    padding: 55px;

    border-radius: 30px;

    overflow: hidden;

    background:
        linear-gradient(
            120deg,
            #151719,
            #0e1012
        );

    border: 1px solid var(--line);
}

.project-card::before {
    content: "";

    position: absolute;

    width: 450px;
    height: 450px;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            var(--purple),
            var(--blue)
        );

    filter: blur(120px);

    opacity: .1;

    right: -180px;
    top: -200px;
}

.project-top {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 80px;
}

.project-tag {
    color: var(--accent);

    font-size: .65rem;

    font-weight: 800;

    letter-spacing: 1.5px;

    text-transform: uppercase;
}

.project-year {
    color: var(--muted);

    font-size: .7rem;
}

.project-card h3 {
    position: relative;

    font-family: "DM Sans", sans-serif;

    color: var(--white);

    font-size: clamp(2rem,5vw,4rem);

    letter-spacing: -2px;

    max-width: 750px;

    line-height: 1;
}

.project-card p {
    position: relative;

    max-width: 650px;

    color: var(--muted);

    font-size: .9rem;

    margin-top: 25px;
}

.project-link {
    display: inline-flex;

    margin-top: 35px;

    color: var(--white);

    text-decoration: none;

    font-size: .75rem;

    font-weight: 800;

    border-bottom: 1px solid var(--white);

    padding-bottom: 5px;
}


/* =========================================================
   CONTACT
========================================================= */

.contact-grid {
    display: grid;

    grid-template-columns: .8fr 1.2fr;

    gap: 70px;
}

.contact-info h3 {
    color: var(--white);

    font-size: 1.6rem;

    margin-bottom: 15px;
}

.contact-info p {
    color: var(--muted);

    font-size: .85rem;

    line-height: 1.9;
}

.contact-note {
    margin-top: 35px;

    color: var(--accent);

    font-size: .68rem;

    letter-spacing: 1px;

    text-transform: uppercase;
}


/* FORM */

form {
    display: grid;

    gap: 25px;
}

.form-row {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 20px;
}

.field {
    position: relative;
}

.field label {
    display: block;

    color: var(--muted);

    font-size: .65rem;

    font-weight: 700;

    letter-spacing: 1px;

    text-transform: uppercase;

    margin-bottom: 8px;
}

.field input,
.field select,
.field textarea {
    width: 100%;

    background: transparent;

    border: none;

    border-bottom: 1px solid var(--line);

    padding: 12px 0;

    color: var(--white);

    font-family: inherit;

    font-size: .85rem;

    outline: none;

    transition: .25s;
}

.field select option {
    background: #111;
}

.field textarea {
    resize: vertical;

    min-height: 110px;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
    border-color: var(--accent);
}

.radio-group,
.checkbox-group {
    display: flex;

    gap: 18px;

    flex-wrap: wrap;
}

.radio-group label,
.checkbox-group label {
    display: flex;

    align-items: center;

    gap: 6px;

    color: var(--muted);

    font-size: .75rem;

    cursor: pointer;
}

input[type="radio"],
input[type="checkbox"] {
    accent-color: var(--accent);
}

.form-buttons {
    display: flex;

    gap: 10px;
}

.submit {
    border: none;

    background: var(--accent);

    color: #080808;

    padding: 13px 24px;

    border-radius: 100px;

    font-family: inherit;

    font-size: .72rem;

    font-weight: 800;

    cursor: pointer;

    transition: .25s;
}

.submit:hover {
    transform: translateY(-3px);

    box-shadow:
        0 10px 30px rgba(201,255,98,.15);
}

.reset {
    border: 1px solid var(--line);

    background: transparent;

    color: var(--white);

    padding: 13px 24px;

    border-radius: 100px;

    font-family: inherit;

    font-size: .72rem;

    cursor: pointer;
}


/* =========================================================
   FOOTER
========================================================= */

footer {
    padding: 45px 0;

    border-top: 1px solid var(--line);

    color: #5d6065;

    font-size: .7rem;

    text-align: center;
}

.footer-name {
    color: var(--white);
}


/* =========================================================
   REVEAL ANIMATION
========================================================= */

@keyframes float {
    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
}

.float-card {
    animation: float 5s ease-in-out infinite;
}

.float-two {
    animation-delay: 1.5s;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

    .nav-links {
        display: none;
    }

    .hero-grid,
    .about-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .hero {
        padding-top: 140px;
    }

    .hero h1 {
        font-size: clamp(3.5rem, 14vw, 6rem);
    }

    .hero-visual {
        justify-content: center;
    }

    .about-number {
        font-size: 5rem;
    }

    .skills-grid,
    .hobby-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .contact-grid {
        gap: 45px;
    }
}


@media (max-width: 600px) {

    .container {
        width: min(100% - 28px, 1180px);
    }

    .navbar {
        top: 10px;

        width: calc(100% - 20px);

        padding-left: 13px;
    }

    .nav-contact {
        padding: 9px 13px;
    }

    .hero {
        min-height: auto;

        padding: 140px 0 80px;
    }

    .hero h1 {
        font-size: 3.3rem;

        letter-spacing: -3px;
    }

    .hero-description {
        font-size: .85rem;
    }

    .profile-card {
        width: min(320px, 90vw);
    }

    .float-one {
        left: -5px;
    }

    .float-two {
        right: -5px;
    }

    .section {
        padding: 85px 0;
    }

    .section-header {
        display: block;
    }

    .section-description {
        margin-top: 20px;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .stat {
        border-right: none;

        border-bottom: 1px solid var(--line);
    }

    .stat:last-child {
        border-bottom: none;
    }

    .skills-grid,
    .hobby-grid {
        grid-template-columns: 1fr;
    }

    .project-card {
        padding: 30px;
    }

    .project-top {
        margin-bottom: 55px;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .contact-grid {
        grid-template-columns: 1fr;
    }
}

</style>
</head>


